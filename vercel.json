{
  "crons": [
    {
      "path": "/api/cron/cleanup?secret=airdrop_recap_bot_secret",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/daily-recap?secret=airdrop_recap_bot_secret",
      "schedule": "55 16 * * *"
    },
    {
      "path": "/api/cron/five-day-recap?secret=airdrop_recap_bot_secret",
      "schedule": "55 16 */5 * *"
    }
  ]
}
